# === DeepSeek AI 分析 (核心,必填) ===
# 注册获取: https://platform.deepseek.com
# 费用: deepseek-v4-pro 约 ¥10-30/月; 换成 deepseek-flash 可低至约 ¥1/月
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
# 分析模型: deepseek-v4-pro (默认, 质量高) 或 deepseek-flash (便宜快速)
DEEPSEEK_MODEL=deepseek-v4-pro

# === 邮箱推送 (可选) ===
# 使用 163 邮箱 SMTP
# 获取授权码: 登录163邮箱 → 设置 → POP3/SMTP/IMAP → 开启SMTP服务 → 获取授权码
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_email@163.com
SMTP_PASS=your_smtp_authorization_code
SMTP_TO=receive_email@163.com

# === 定时推送 (GitHub Actions 控制,本地无需配置) ===
# 每天下午 6:00 北京时间自动生成
TZ=Asia/Shanghai
