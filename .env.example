# === DeepSeek AI 分析 (核心,必填) ===
# 注册获取: https://platform.deepseek.com
# 费用: 约 ¥1/月 (极便宜)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# === 邮箱推送 (可选) ===
# 使用 QQ 邮箱 SMTP
# 获取授权码: QQ邮箱 → 设置 → 账户 → POP3/SMTP服务 → 生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_qq_email@qq.com
SMTP_PASS=your_qq_smtp_authorization_code
SMTP_TO=receive_email@qq.com

# === 定时推送 (GitHub Actions 控制,本地无需配置) ===
# 每天早上 8:00 北京时间自动生成
TZ=Asia/Shanghai
